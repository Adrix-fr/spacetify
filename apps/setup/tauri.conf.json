{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spacetify",
  "mainBinaryName": "spacetify-setup",
  "identifier": "io.github.adrix-fr.spacetify.setup",
  "build": {
    "frontendDist": "../desktop/dist-setup",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "spacetify team",
    "copyright": "GPL-3.0-or-later",
    "shortDescription": "spacetify installer",
    "icon": ["../desktop/src-tauri/icons/icon.png", "../desktop/src-tauri/icons/icon.ico"]
  }
}
